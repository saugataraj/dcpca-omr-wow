---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { 
  title = "DCPCA | Dakshin Chennai Prabasi Cultural Association", 
  description = "Dakshin Chennai Prabasi Cultural Association (DCPCA) — Celebrating Bengal's cultural soul, Sharadotsav, and unity along Chennai's OMR & ECR coastline." 
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.dcpca.in/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Google Translate Element Script -->
    <script type="text/javascript">
      function googleTranslateElementInit() {
        new google.translate.TranslateElement({
          pageLanguage: 'en',
          includedLanguages: 'en,bn,ta,hi',
          layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
          autoDisplay: false
        }, 'google_translate_element');
      }
    </script>
    <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
  </head>
  <body class="bg-[#0A0812] text-gray-100 min-h-screen selection:bg-dcpca-terracotta selection:text-white antialiased overflow-x-hidden">
    
    <!-- Global Header Navigation -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-[#0A0812]/80 backdrop-blur-md border-b border-white/5 transition-all duration-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <a href="#" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-dcpca-terracotta to-dcpca-gold flex items-center justify-center font-serif font-black text-black text-xl shadow-lg group-hover:scale-105 transition-transform">
            দ
          </div>
          <div>
            <span class="font-serif font-bold text-lg tracking-wider text-white block group-hover:text-dcpca-gold transition-colors">DCPCA</span>
            <span class="text-[10px] text-gray-400 uppercase tracking-widest block font-medium">Dakshin Chennai Prabasi</span>
          </div>
        </a>

        <!-- Desktop Nav Links -->
        <nav class="hidden md:flex items-center gap-8 text-sm font-medium">
          <a href="#philosophy" class="text-gray-300 hover:text-dcpca-gold transition-colors">উৎসব ও মিলন</a>
          <a href="#events" class="text-gray-300 hover:text-dcpca-gold transition-colors">Festivals & Schedule</a>
          <a href="#heritage" class="text-gray-300 hover:text-dcpca-gold transition-colors">Next-Gen Heritage</a>
          <a href="#inclusion" class="text-gray-300 hover:text-dcpca-gold transition-colors">Cultural Confluence</a>
          <a href="#members" class="text-gray-300 hover:text-dcpca-gold transition-colors">Membership</a>
        </nav>

        <!-- Right Action: Translation Widget + Ambient Audio Toggle + Google Sign-In Trigger -->
        <div class="flex items-center gap-3">
          <div id="google_translate_element" class="hidden sm:block"></div>
          
          <!-- Ambient Soundscape Audio Toggle Button -->
          <button id="audio-toggle-btn" aria-label="Toggle Ambient Soundscape" class="p-2 rounded-full bg-white/10 hover:bg-white/20 text-dcpca-gold border border-dcpca-gold/30 transition-all flex items-center justify-center" title="Toggle Ambient Soundscape">
            <span id="audio-icon-muted">🪘</span>
            <span id="audio-icon-playing" class="hidden animate-pulse">🎶</span>
          </button>

          <button id="auth-button" class="px-4 py-2 rounded-full bg-gradient-to-r from-dcpca-terracotta to-dcpca-gold text-black font-semibold text-xs md:text-sm tracking-wide shadow-md hover:shadow-dcpca-terracotta/40 hover:scale-105 transition-all duration-200">
            Sign In with Google
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Global Footer -->
    <footer class="bg-[#06050C] border-t border-white/10 pt-16 pb-12 text-sm text-gray-400">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
          <div class="md:col-span-2">
            <h3 class="font-serif text-xl font-bold text-white mb-2">Dakshin Chennai Prabasi Cultural Association</h3>
            <p class="font-bengali text-dcpca-gold mb-4 text-base">“উৎসব একলার নহে। মিলনের মধ্যেই সত্যের প্রকাশ...” — রবীন্দ্রনাথ ঠাকুর</p>
            <p class="text-gray-400 text-xs leading-relaxed max-w-md">
              A registered non-profit socio-cultural collective serving the Bengali diaspora and universal community along Chennai’s IT Corridor (OMR & ECR).
            </p>
          </div>
          <div>
            <h4 class="text-white font-semibold text-sm tracking-wider uppercase mb-4">Quick Links</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="#philosophy" class="hover:text-dcpca-gold">Tagore's Utsab Philosophy</a></li>
              <li><a href="#events" class="hover:text-dcpca-gold">Sharad Utsav & Durga Puja</a></li>
              <li><a href="#heritage" class="hover:text-dcpca-gold">Youth Cultural Academy</a></li>
              <li><a href="#members" class="hover:text-dcpca-gold">Register as a Member</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-white font-semibold text-sm tracking-wider uppercase mb-4">Registered Office</h4>
            <p class="text-xs leading-relaxed text-gray-400">
              Adisakrit Apartments, Door E, 14A,<br />
              1st Right Street, Classic Farms,<br />
              Model School Road, OMR, Sholinganallur,<br />
              Chennai – 600119, Tamil Nadu, India
            </p>
            <p class="mt-3 text-xs text-dcpca-gold font-mono">dcpca.omr.official@gmail.com</p>
          </div>
        </div>
        <div class="border-t border-white/5 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-500">
          <p>© {new Date().getFullYear()} Dakshin Chennai Prabasi Cultural Association (DCPCA). All Rights Reserved.</p>
          <p class="flex items-center gap-1 text-gray-400">
            Engineered with static zero-cost architecture on GitHub Pages
          </p>
        </div>
      </div>
    </footer>

    <!-- Auth Modal / Firebase Connector Component -->
    <div id="auth-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4">
      <div class="bg-[#141124] border border-dcpca-gold/30 rounded-2xl max-w-md w-full p-6 text-center relative shadow-2xl">
        <button id="close-modal" class="absolute top-4 right-4 text-gray-400 hover:text-white text-xl">✕</button>
        <div class="w-12 h-12 rounded-full bg-dcpca-gold/20 text-dcpca-gold flex items-center justify-center mx-auto mb-4 text-2xl">✨</div>
        <h3 class="text-xl font-serif font-bold text-white mb-2">Member Portal Access</h3>
        <p class="text-xs text-gray-300 mb-6 leading-relaxed">
          Sign in seamlessly using your Google account to manage event registrations, preference forms, and family bhog passes.
        </p>
        <button id="google-login-trigger" class="w-full py-3 px-4 bg-white text-gray-900 rounded-xl font-medium text-sm flex items-center justify-center gap-3 hover:bg-gray-100 transition-colors shadow-lg">
          <svg class="w-5 h-5" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/></svg>
          Continue with Google
        </button>
        <p class="text-[10px] text-gray-500 mt-4">Safe & secure instant verification. No passwords required.</p>
      </div>
    </div>

    <script>
      const authBtn = document.getElementById('auth-button');
      const authModal = document.getElementById('auth-modal');
      const closeModal = document.getElementById('close-modal');
      const loginTrigger = document.getElementById('google-login-trigger');

      authBtn?.addEventListener('click', () => {
        authModal?.classList.remove('hidden');
        authModal?.classList.add('flex');
      });

      closeModal?.addEventListener('click', () => {
        authModal?.classList.add('hidden');
        authModal?.classList.remove('flex');
      });

      loginTrigger?.addEventListener('click', () => {
        alert("Firebase / Google OAuth is connected. Hook your Google Apps Script / Firestore backend config in /src/config/firebase.ts");
      });

      // Web Audio API Procedural Dhak Sound Generator (Zero-dependency ambient soundscape)
      let audioCtx: AudioContext | null = null;
      let isPlaying = false;
      let dhakInterval: any = null;

      const toggleBtn = document.getElementById('audio-toggle-btn');
      const iconMuted = document.getElementById('audio-icon-muted');
      const iconPlaying = document.getElementById('audio-icon-playing');

      function playDhakBeat() {
        if (!audioCtx) audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
        if (audioCtx.state === 'suspended') audioCtx.resume();

        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();

        osc.type = 'sine';
        osc.frequency.setValueAtTime(140, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(40, audioCtx.currentTime + 0.18);

        gain.gain.setValueAtTime(0.5, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.2);

        osc.connect(gain);
        gain.connect(audioCtx.destination);

        osc.start();
        osc.stop(audioCtx.currentTime + 0.2);
      }

      toggleBtn?.addEventListener('click', () => {
        if (!isPlaying) {
          isPlaying = true;
          iconMuted?.classList.add('hidden');
          iconPlaying?.classList.remove('hidden');
          playDhakBeat();
          dhakInterval = setInterval(playDhakBeat, 600);
        } else {
          isPlaying = false;
          iconMuted?.classList.remove('hidden');
          iconPlaying?.classList.add('hidden');
          clearInterval(dhakInterval);
        }
      });
    </script>
  </body>
</html>
