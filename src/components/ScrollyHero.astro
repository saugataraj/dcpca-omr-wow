---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const heroBgSrc1 = `${baseUrl}gallery/2024_01.jpeg`;
const heroBgSrc2 = `${baseUrl}gallery/2023_01.jpeg`;
---

<div id="hero-wrapper" class="relative w-full h-[300vh] bg-[#0A0812] text-white overflow-clip">
  <!-- Archival Photo Parallax Backdrops -->
  <div class="fixed top-0 left-0 w-full h-screen pointer-events-none z-0 overflow-hidden">
    <img
      id="hero-bg-1"
      src={heroBgSrc1}
      alt="Ambient Hero Backdrop 2024"
      class="w-full h-full object-cover opacity-25 filter blur-xs scale-105 transition-opacity duration-1000"
    />
    <img
      id="hero-bg-2"
      src={heroBgSrc2}
      alt="Ambient Hero Backdrop 2023"
      class="w-full h-full object-cover opacity-0 filter blur-xs scale-105 transition-opacity duration-1000 absolute inset-0"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-[#0A0812]/80 via-[#0A0812]/60 to-[#0A0812]"></div>
  </div>

  <!-- Sticky Canvas Container -->
  <div id="sticky-hero" class="sticky top-0 left-0 w-full h-screen flex flex-col justify-between items-center py-8 px-4 sm:px-8 z-10 overflow-hidden">
    
    <!-- Top Bar Spacer -->
    <div class="w-full max-w-7xl flex justify-between items-center text-xs font-mono tracking-widest text-dcpca-gold/70 uppercase">
      <span class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-dcpca-gold animate-pulse"></span>
        Dakshin Chennai Prabasi Cultural Association
      </span>
      <span class="hidden sm:inline-block border border-dcpca-gold/30 px-3 py-1 rounded-full text-[10px]">
        Chennai, TN • Reg: SRG/Chennai South/310/2021
      </span>
    </div>

    <!-- Center Canvas -->
    <div class="relative w-full max-w-5xl mx-auto flex items-center justify-center flex-1">
      
      <!-- Ambient Interactive Mandala -->
      <div id="mandala-bg" class="absolute w-[320px] h-[320px] sm:w-[500px] sm:h-[500px] rounded-full border border-dcpca-gold/20 flex items-center justify-center pointer-events-none transition-transform duration-1000 ease-out">
        <div class="w-4/5 h-4/5 rounded-full border border-dcpca-terracotta/30 rotate-45 border-dashed"></div>
        <div class="w-3/5 h-3/5 rounded-full border border-dcpca-gold/30 -rotate-12"></div>
        <div class="w-2/5 h-2/5 rounded-full bg-gradient-to-tr from-dcpca-terracotta/20 to-dcpca-gold/10 backdrop-blur-3xl"></div>
      </div>

      <!-- FOLD 1: Tagore Philosophy / Heritage Anchor -->
      <div id="fold-1" class="hero-fold absolute inset-0 flex flex-col items-center justify-center text-center px-4 transition-all duration-700 opacity-100 scale-100">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-dcpca-gold/10 border border-dcpca-gold/30 text-dcpca-gold text-xs font-semibold tracking-wider uppercase mb-6 shadow-lg shadow-dcpca-gold/5">
          <span class="text-sm">✨</span> DAKSHIN CHENNAI PRABASI CULTURAL ASSOCIATION
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-serif font-bold tracking-tight text-white mb-6 leading-tight">
          উৎসব সবার, <span class="text-transparent bg-clip-text bg-gradient-to-r from-dcpca-gold via-dcpca-goldLight to-dcpca-terracotta">মিলন সবার</span>
        </h1>

        <blockquote class="max-w-2xl text-base sm:text-xl font-bengali text-dcpca-goldLight/90 italic mb-6 leading-relaxed">
          “মিলনের মধ্যেই সত্যের প্রকাশ— সেই মিলনের মধ্যেই সত্যকে অনুভব করা • উৎসবের সম্পূর্ণতা।”
        </blockquote>

        <p class="max-w-xl text-gray-300 text-sm sm:text-base font-light leading-relaxed mb-8">
          Where Bengal's soulful artistic legacy thrives along the Coromandel Coast of Chennai.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href={`${baseUrl}#schedule`} class="px-8 py-3.5 rounded-full bg-gradient-to-r from-dcpca-terracotta to-dcpca-gold text-black font-bold text-sm hover:scale-105 transition-all shadow-xl shadow-dcpca-terracotta/20">
            Explore Sharad Utsav
          </a>
          <a href={`${baseUrl}#philosophy`} class="px-8 py-3.5 rounded-full bg-white/5 border border-white/15 text-white font-medium text-sm hover:bg-white/10 transition-all backdrop-blur-md">
            Our Philosophy (Utsab)
          </a>
        </div>
      </div>

      <!-- FOLD 2: 13th Year Milestone Overhaul -->
      <div id="fold-2" class="hero-fold absolute inset-0 flex flex-col items-center justify-center text-center px-4 transition-all duration-700 opacity-0 scale-95 pointer-events-none">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-dcpca-terracotta/20 border border-dcpca-terracotta/40 text-dcpca-terracotta text-xs font-bold tracking-widest uppercase mb-6">
          <span>🏛️</span> 13TH EDITION FLAGSHIP SHARADOTSAV
        </div>

        <h2 class="text-3xl sm:text-5xl lg:text-6xl font-serif font-bold text-white mb-4 leading-tight">
          12 Years of Devotion, Celebrating Our <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-dcpca-gold to-dcpca-terracotta">Milestone 13th Year on Chennai's OMR</span>
        </h2>

        <p class="max-w-2xl text-gray-300 text-sm sm:text-base font-light leading-relaxed mb-8">
          From our modest inaugural celebration in 2014 to Chennai's premier cultural haven along Rajiv Gandhi Salai (OMR), binding hundreds of Prabasi families in unity.
        </p>

        <!-- Milestone Banner Linking directly to Retrospective Gallery -->
        <a
          href={`${baseUrl}#gallery`}
          class="group relative inline-flex items-center gap-4 px-8 py-4 rounded-2xl bg-gradient-to-r from-[#1E1735] to-[#2B1B47] border border-dcpca-gold/40 hover:border-dcpca-gold shadow-2xl transition-all hover:scale-105"
        >
          <div class="w-12 h-12 rounded-xl bg-dcpca-gold/20 flex items-center justify-center text-2xl group-hover:rotate-12 transition-transform">
            🖼️
          </div>
          <div class="text-left">
            <span class="text-[10px] font-mono uppercase tracking-widest text-dcpca-gold block">Interactive Visual Retrospective</span>
            <span class="text-base font-serif font-bold text-white group-hover:text-dcpca-goldLight transition-colors">
              12 Years of Memories, 13th Year of Glory →
            </span>
          </div>
        </a>
      </div>

      <!-- FOLD 3: Cultural Confluence & Tamil Nadu Harmony -->
      <div id="fold-3" class="hero-fold absolute inset-0 flex flex-col items-center justify-center text-center px-4 transition-all duration-700 opacity-0 scale-95 pointer-events-none">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-purple-500/20 border border-purple-400/30 text-purple-300 text-xs font-semibold tracking-wider uppercase mb-6">
          <span>🌺</span> BENGAL & TAMIL NADU CULTURAL CONFLUENCE
        </div>

        <h2 class="text-3xl sm:text-5xl font-serif font-bold text-white mb-4">
          Where <span class="text-dcpca-gold">Durga Puja</span> Meets <span class="text-dcpca-terracotta">Sharad Navratri</span>
        </h2>

        <p class="max-w-2xl text-gray-300 text-xs sm:text-base leading-relaxed mb-6">
          Honouring Shakti, classical Carnatic and Bengali music, and the timeless Tamil philosophy of universal brotherhood.
        </p>

        <div class="bg-black/50 border border-dcpca-gold/30 p-4 sm:p-6 rounded-2xl max-w-xl mx-auto backdrop-blur-md mb-8">
          <p class="font-serif text-lg font-bold text-dcpca-goldLight">“யாதும் ஊரே யாவரும் கேளிர்”</p>
          <p class="text-xs text-gray-400 mt-1 italic">“To us all towns are one, all people our kin.”</p>
        </div>

        <a href={`${baseUrl}#confluence`} class="px-8 py-3.5 rounded-full bg-dcpca-gold text-black font-bold text-sm hover:scale-105 transition-all shadow-xl">
          Learn About Cultural Harmony
        </a>
      </div>

    </div>

    <!-- Bottom Scroll Indicator -->
    <div class="w-full text-center pb-4 z-20">
      <div class="inline-flex flex-col items-center text-dcpca-gold/70 text-[10px] font-mono tracking-widest uppercase">
        <span>SCROLL DOWN</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mt-1 animate-bounce text-dcpca-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7-7-7" />
        </svg>
      </div>
    </div>

  </div>
</div>

<script>
  // Parallax Scroll Observer
  document.addEventListener('DOMContentLoaded', () => {
    const heroWrapper = document.getElementById('hero-wrapper');
    const fold1 = document.getElementById('fold-1');
    const fold2 = document.getElementById('fold-2');
    const fold3 = document.getElementById('fold-3');
    const mandalaBg = document.getElementById('mandala-bg');
    const heroBg1 = document.getElementById('hero-bg-1');
    const heroBg2 = document.getElementById('hero-bg-2');

    if (!heroWrapper || !fold1 || !fold2 || !fold3) return;

    window.addEventListener('scroll', () => {
      const rect = heroWrapper.getBoundingClientRect();
      const scrollProgress = -rect.top / (rect.height - window.innerHeight);

      if (mandalaBg) {
        mandalaBg.style.transform = `scale(${1 + scrollProgress * 0.4}) rotate(${scrollProgress * 90}deg)`;
      }

      if (scrollProgress < 0.33) {
        showFold(fold1);
        hideFold(fold2);
        hideFold(fold3);
        if (heroBg1) heroBg1.style.opacity = '0.25';
        if (heroBg2) heroBg2.style.opacity = '0';
      } else if (scrollProgress >= 0.33 && scrollProgress < 0.66) {
        hideFold(fold1);
        showFold(fold2);
        hideFold(fold3);
        if (heroBg1) heroBg1.style.opacity = '0';
        if (heroBg2) heroBg2.style.opacity = '0.25';
      } else {
        hideFold(fold1);
        hideFold(fold2);
        showFold(fold3);
        if (heroBg1) heroBg1.style.opacity = '0.15';
        if (heroBg2) heroBg2.style.opacity = '0.15';
      }
    });

    function showFold(el: HTMLElement) {
      el.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
      el.classList.add('opacity-100', 'scale-100');
    }

    function hideFold(el: HTMLElement) {
      el.classList.remove('opacity-100', 'scale-100');
      el.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
    }
  });
</script>
